<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voir toutes les apps installées (Android 11+). L'app n'est pas publiée sur le
         Play Store, cette permission est donc acceptable. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Internet : calendrier NBA et logos des équipes -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Télécommande smartphone : re-sélectionner le clavier iBiProjo quand un téléphone se
         connecte (permission accordée seulement par adb : pm grant, voir l'aide dans Réglages) -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- État du réseau, pour afficher le nom du Wi-Fi quand c'est possible -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Mise à jour de Projo depuis GitHub (Android demande toujours confirmation) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Puces NFC (Fire TV) : réveiller le Fire TV quand une puce ouvre une app -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Fire TV : ouvrir iBiProjo au démarrage de l'appareil -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth : afficher l'état et les appareils associés (Android 11 et moins) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <!-- Module Minuteur et réveil : notifications (Android 13+), alarme exacte (Android 12+,
         repli inexact sans elle) et écran d'alarme plein écran -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Design « Studio » : app la plus récemment utilisée (accès aux données d'utilisation,
         accordé dans les réglages ou par adb : appops set fr.projo.launcher GET_USAGE_STATS allow) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Design « Studio » : suggestions de films et séries lues sur TMDB (INTERNET, déjà déclaré) -->

    <!-- Mode Ambiance : néon réactif à la musique. Le « Visualizer » d'Android donne le spectre
         du son qui sort de l'appareil (rien n'est enregistré, gardé ni envoyé) ; il demande
         l'autorisation micro, et MODIFY_AUDIO_SETTINGS pour la sortie générale (session 0).
         Accordée par la fenêtre d'Android, ou par adb : pm grant fr.projo.launcher android.permission.RECORD_AUDIO -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Projecteur : pas d'écran tactile, Leanback non obligatoire (marche aussi hors Android TV) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Repli pour la visibilité des apps si la permission ci-dessus était refusée -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Projo">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">

            <!-- Visible dans la liste d'apps classique et Android TV -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Candidat comme écran d'accueil (bouton Maison) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Fire TV : ouverture automatique à la place de l'accueil d'Amazon
             (à activer dans Paramètres → Accessibilité) -->
        <service
            android:name=".system.RedirectionAccueil"
            android:exported="true"
            android:label="@string/redirection_nom"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/redirection_accueil" />
        </service>

        <!-- Fire TV : ouverture au démarrage (anciennes versions de Fire OS) -->
        <receiver
            android:name=".system.DemarrageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Module Minuteur et réveil : écran d'alarme par-dessus l'app en cours, et récepteur
             de l'échéance (AlarmManager) et des boutons de notification -->
        <activity
            android:name=".modules.minuteur.AlarmeActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:showWhenLocked="true"
            android:taskAffinity="fr.projo.launcher.alarme"
            android:theme="@style/Theme.Projo"
            android:turnScreenOn="true"
            tools:targetApi="o_mr1" />
        <receiver
            android:name=".modules.minuteur.MinuteurReceiver"
            android:exported="false" />
        <!-- Télécommande smartphone : clavier iBiProjo (texte tapé sur le téléphone) -->
        <service
            android:name=".remote.ClavierTelecommande"
            android:exported="true"
            android:label="@string/clavier_nom"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <!-- Télécommande smartphone : navigation hors des champs texte (accessibilité).
             Fire TV : désactivé (bool telecommande_service_navigation), le service
             d'ouverture automatique porte aussi ce rôle. -->
        <service
            android:name=".remote.NavigationTelecommande"
            android:enabled="@bool/telecommande_service_navigation"
            android:exported="true"
            android:label="@string/navigation_nom"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/navigation_telecommande" />
        </service>
        <!-- Mode Ambiance : couleur de la pochette du morceau en cours (session média). Ce service
             ne lit aucune notification. Accès à donner une fois (l'écran manque souvent sur Fire TV) :
             adb shell cmd notification allow_listener fr.projo.launcher/fr.projo.launcher.ambiance.EcouteNotifications -->
        <service
            android:name=".ambiance.EcouteNotifications"
            android:exported="true"
            android:label="@string/ambiance_notifications_nom"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Partage de l'APK de mise à jour avec l'installeur d'Android -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fichiers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fichiers" />
        </provider>
    </application>
</manifest>
